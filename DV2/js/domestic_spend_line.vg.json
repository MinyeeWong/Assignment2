{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "title": {
      "fontSize": 24,
      "fontWeight": "bold"
    },
    "legend": {
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    }
  },
  "width": 290,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/domestic_trip_overnightspend.csv"
  },
  "transform": [
    {
      "calculate": "split(datum.Quarter, ' ')[2]",
      "as": "Year"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "Spend ($M)", "as": "YearlySpend"}
      ],
      "groupby": ["State", "Year"]
    }
  ],
  "layer": [
    {
      "selection": {
        "state_select": {"type": "multi", "fields": ["State"], "bind": "legend"}
      },
      "mark": "line",
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year"
        },
        "y": {
          "field": "YearlySpend",
          "type": "quantitative",
          "title": "Spend ($M)"
        },
        "color": {
          "condition": {
            "selection": "state_select",
            "field": "State",
            "type": "nominal"
          },
          "value": "lightgray"
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Year", "type": "ordinal"},
          {"field": "YearlySpend", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "red", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2020"}}
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "dy": -380,
        "fontSize": 13,
        "color": "red"
      },
      "encoding": {
        "x": {"datum": "2020"},
        "y": {"datum": 18000},
        "text": {"value": "Lowest domestic spend in 2020"}
      }
    }
  ]
}
