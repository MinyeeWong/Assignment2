{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "config": {
    "font": "Roboto, 'Open Sans'",
    "title": {
      "font": "Roboto, 'Open Sans'",
      "fontSize": 24,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#333"
    },
    "legend": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'",
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'",
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    },
    "header": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'"
    },
    "text": {
      "font": "Roboto, 'Open Sans'",
      "fontSize": 12,
      "color": "#333"
    },
    "mark": {
      "font": "Roboto, 'Open Sans'"
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/type_of_accomodation.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"fold": ["year ending 2019", "year ending 2024"], "as": ["Year", "Stays"]},
    {"calculate": "datum.Year == 'year ending 2019' ? 2019 : 2024", "as": "Year"},
    {"filter": "datum.Type != null && datum.Type != ''"}
  ],
  "layer": [
    {
      "mark": {"type": "arc", "tooltip": true},
      "encoding": {
        "theta": {"field": "Type", "type": "nominal"},
        "radius": {
          "field": "Stays",
          "type": "quantitative",
          "scale": {"type": "log", "base": 10, "zero": false, "domainMin": 1}
        },
        "color": {"field": "Year", "type": "ordinal", "scale": {"scheme": "set2"}},
        "tooltip": [
          {"field": "Type", "type": "nominal"},
          {"field": "Year", "type": "ordinal"},
          {"field": "Stays", "type": "quantitative"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "dx": 30, "dy": 10},
      "encoding": {
        "theta": {"value": 1.0},
        "radius": {"value": 150},
        "text": {"value": "Adventure stays decreased post-pandemic"}
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "dx": -50, "dy": -30},
      "encoding": {
        "theta": {"value": 4.5},
        "radius": {"value": 100},
        "text": {"value": "Hotels/resorts – strong increase"}
      }
    }
  ],
  "view": {"stroke": null},
  "width": 500,
  "height": 400
}
