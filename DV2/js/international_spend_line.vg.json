{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "title": {
      "fontSize": 24,
      "fontWeight": "bold"
    },
    "legend": {
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    }
  },
  "width": 290,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/international_spending_data.csv"
  },
  "layer": [
    {
      "selection": {
        "state_select": {"type": "multi", "fields": ["State"], "bind": "legend"}
      },
      "mark": "line",
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "spending",
          "type": "quantitative",
          "title": "Spend ($M)"
        },
        "color": {
          "condition": {
            "selection": "state_select",
            "field": "State",
            "type": "nominal"
          },
          "value": "lightgray"
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "year", "type": "ordinal"},
          {"field": "spending", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "red", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2021"}}
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "dy": 20,
        "fontSize": 13,
        "font": "Arial",
        "color": "red"
      },
      "encoding": {
        "x": {"datum": "2021"},
        "y": {"datum": 13000}, 
        "text": {"value": "Lowest international spend in 2021"}
      }
    }
  ]
}