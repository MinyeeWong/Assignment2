{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "config": {
    "font": "Roboto, 'Open Sans'",
    "title": {
      "font": "Roboto, 'Open Sans'",
      "fontSize": 24,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#333"
    },
    "legend": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'",
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'",
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    },
    "header": {
      "titleFont": "Roboto, 'Open Sans'",
      "labelFont": "Roboto, 'Open Sans'"
    },
    "text": {
      "font": "Roboto, 'Open Sans'",
      "fontSize": 12,
      "color": "#333"
    },
    "mark": {
      "font": "Roboto, 'Open Sans'"
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/main_reason_trips_spending.csv"
  },
  "params": [
    {
      "name": "valueType",
      "value": "Visitors",
      "bind": {
        "input": "select",
        "options": ["Visitors", "Spend"],
        "labels": ["Visitors", "Spend"],
        "name": "Show: "
      }
    }
  ],
  "transform": [
    { "filter": "datum.Type == valueType" }
  ],
  "mark": {
    "type": "point",
    "shape": "M0,-1 L0.5,0.5 L0,0.3 L-0.5,0.5 Z",
    "filled": true,
    "stroke":"darkblue",
    "strokeWidth":0.5
  },
  "encoding": {
    "x": { "field": "Year", "type": "ordinal", "title": "Year" },
    "y": { "field": "Reason", "type": "nominal", "title": "Reason for Travel" },
    "size": { 
      "field": "Value", 
      "type": "quantitative",
      "title": "Value",
      "scale": {"type": "sqrt", "range": [200, 2000]}
    },
    "color": { 
      "field": "Value",
      "type": "quantitative",
      "scale": {"scheme": "blues"}
    },
    "tooltip": [
      { "field": "Year" },
      { "field": "Reason" },
      { "field": "Type" },
      { "field": "Value", "type": "quantitative", "format": "," }
    ]
  },
  "width": 650,
  "height": 400
}
