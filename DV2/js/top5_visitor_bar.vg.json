{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "title": {
      "fontSize": 24,
      "fontWeight": "bold"
    },
    "legend": {
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    }
  },
  "width": 750,
  "height": 600,
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/Top5_visitor.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "Visitors",
      "type": "quantitative",
      "title": "Number of Visitors"
    },
    "color": {
      "field": "Country",
      "type": "nominal",
      "title": "Country"
    },
    "xOffset": {"field": "Country"},
    "tooltip": [
      {"field": "Country", "type": "nominal"},
      {"field": "Year", "type": "ordinal"},
      {"field": "Visitors", "type": "quantitative", "format": ","}
    ]
  }
}
