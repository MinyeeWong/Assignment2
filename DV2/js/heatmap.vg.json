{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 650, 
  "height": 400,
  "config": {
    "title": {
      "fontSize": 24,
      "fontWeight": "bold"
    },
    "legend": {
      "titleFontSize": 14,
      "labelFontSize": 12
    },
    "axis": {
      "titleFontSize": 14,
      "titleFontWeight": "bold",
      "labelFontSize": 12
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/expenditure_breakdown_by_reason.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "fold": [
        "Holiday",
        "Visiting friends and relatives",
        "Business",
        "Education",
        "Other purpose(c)"
      ],
      "as": ["Purpose", "Value"]
    },
    {
      "calculate": "datum.Value == 'np' ? 0 : toNumber(datum.Value)",
      "as": "Value"
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "Purpose",
      "type": "ordinal",
      "title": "Purpose"
    },
    "y": {
      "field": "Expenditure ($M)",
      "type": "ordinal",
      "title": "Expenditure Type"
    },
    "color": {
      "field": "Value",
      "type": "quantitative",
      "scale": {"scheme": "blues"},
      "title": "Expenditure ($M)"
    },
    "tooltip": [
      {"field": "Expenditure ($M)", "title": "Expenditure Type"},
      {"field": "Purpose"},
      {"field": "Value", "title": "Amount"}
    ]
  }
}
