{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of Reason vs Year for Visitors or Spend, switchable via dropdown.",
  "data": {
    "url": "https://raw.githubusercontent.com/MinyeeWong/Assignment2/refs/heads/main/DV2/data/main_reason_trips_spending.csv"
  },
  "params": [
    {
      "name": "valueType",
      "value": "Visitors",
      "bind": {
        "input": "select",
        "options": ["Visitors", "Spend"],
        "labels": ["Visitors", "Spend"],
        "name": "Show: "
      }
    }
  ],
  "transform": [
    { "filter": "datum.Type == valueType" }
  ],
  "mark": "rect",
  "encoding": {
    "x": { "field": "Year", "type": "ordinal", "title": "Year" },
    "y": { "field": "Reason", "type": "nominal", "title": "Reason for Travel" },
    "color": { 
      "field": "Value", 
      "type": "quantitative",
      "title": {"signal": "valueType"},
      "scale": {"scheme": "blues"}
    },
    "tooltip": [
      { "field": "Year", "type": "ordinal" },
      { "field": "Reason", "type": "nominal" },
      { "field": "Type", "type": "nominal" },
      { "field": "Value", "type": "quantitative", "format": "," }
    ]
  },
  "width": 750,
  "height": 400,
  "config": {
    "axis": { "labelFontSize": 12, "titleFontSize": 14, "titleFontWeight": "bold" },
    "legend": { "labelFontSize": 12, "titleFontSize": 14 }
  }
}
